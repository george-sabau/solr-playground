{
  "name": "solr-playground",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/run-next-dev.mjs",
    "dev:stack": "node scripts/dev-stack.mjs",
    "stop:stack": "node scripts/stop-stack.mjs",
    "seed:solr": "node scripts/generate-solr-seed.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-native-modules.mjs",
    "test": "vitest run",
    "test:regression": "node scripts/ensure-native-modules.mjs && vitest run src/lib/persistence src/lib/solr/endpoints.test.ts src/app/api/presets",
    "test:watch": "vitest",
    "db:migrate": "node scripts/db-migrate.mjs",
    "postinstall": "node scripts/ensure-native-modules.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "kill-port": "^2.0.1",
    "playwright": "^1.52.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
